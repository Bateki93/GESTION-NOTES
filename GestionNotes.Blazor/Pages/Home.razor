@page "/"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Accueil - GestionNotes</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="home-container">
            <div class="hero-section authorized-hero">
                <div class="hero-content">
                    <div class="avatar-circle">
                        <span class="avatar-text">@initials</span>
                    </div>
                    <h1 class="hero-title">Bon retour, @displayName !</h1>
                    <p class="hero-subtitle">
                        <span class="badge-role @(isAdmin ? "badge-admin" : "badge-student")">
                            @(isAdmin ? "Administrateur" : "Élève")
                        </span>
                    </p>
                </div>
            </div>

            @if (isAdmin)
            {
                <div class="dashboard-grid">
                    <div class="stat-card" style="--card-color: #4f46e5;">
                        <div class="stat-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Matières</span>
                            <span class="stat-link" @onclick="GoToMatieres">Gérer →</span>
                        </div>
                    </div>

                    <div class="stat-card" style="--card-color: #059669;">
                        <div class="stat-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Élèves</span>
                            <span class="stat-link" @onclick="GoToEleves">Gérer →</span>
                        </div>
                    </div>

                    <div class="stat-card" style="--card-color: #d97706;">
                        <div class="stat-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Notes</span>
                            <span class="stat-link" @onclick="GoToNotes">Gérer →</span>
                        </div>
                    </div>
                </div>

                <div class="quick-actions">
                    <h2 class="section-title">Actions rapides</h2>
                    <div class="actions-row">
                        <button class="action-btn" @onclick="GoToMatieres">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            Nouvelle matière
                        </button>
                        <button class="action-btn" @onclick="GoToRegister">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            Nouvel élève
                        </button>
                        <button class="action-btn" @onclick="GoToNotes">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            Saisir une note
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="dashboard-grid single-card">
                    <div class="stat-card highlight" style="--card-color: #4f46e5;">
                        <div class="stat-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">Mes notes</span>
                            <span class="stat-value">Consulte tes résultats</span>
                            <span class="stat-link" @onclick="GoToMesNotes">Voir mes notes →</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="home-container">
            <div class="hero-section">
                <div class="hero-content">
                    <div class="logo-icon">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
                            <circle cx="12" cy="12" r="2"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M4.93 4.93l1.41 1.41"/><path d="M17.66 17.66l1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M6.34 17.66l-1.41 1.41"/><path d="M19.07 4.93l-1.41 1.41"/>
                        </svg>
                    </div>
                    <h1 class="hero-title">GestionNotes</h1>
                    <p class="hero-subtitle">La plateforme moderne de gestion des notes scolaires</p>
                    <div class="hero-actions">
                        <a href="/login" class="btn-primary-custom">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            Se connecter
                        </a>
                        <a href="/register" class="btn-secondary-custom">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                            S'inscrire
                        </a>
                    </div>
                </div>
            </div>

            <div class="features-section">
                <h2 class="section-title">Pourquoi GestionNotes ?</h2>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon" style="background: #eef2ff; color: #4f46e5;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </div>
                        <h3>Gestion des notes</h3>
                        <p>Saisie et consultation des notes en temps réel, avec coefficients et semestres.</p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon" style="background: #ecfdf5; color: #059669;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                        </div>
                        <h3>Profils élèves</h3>
                        <p>Chaque élève dispose d'un espace personnel pour suivre sa scolarité.</p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon" style="background: #fffbeb; color: #d97706;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </div>
                        <h3>Matières & coefficients</h3>
                        <p>Configuration flexible des matières avec coefficients personnalisables.</p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon" style="background: #fef2f2; color: #dc2626;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                        </div>
                        <h3>Tableau de bord</h3>
                        <p>Vue d'ensemble claire avec accès rapide à toutes les fonctionnalités.</p>
                    </div>
                </div>
            </div>

            <div class="cta-section">
                <h2>Prêt à commencer ?</h2>
                <p>Rejoins GestionNotes et simplifie la gestion des notes.</p>
                <a href="/register" class="btn-primary-custom btn-lg">Créer un compte</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isAdmin;
    private string displayName = "";
    private string initials = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        isAdmin = user.IsInRole("1");

        var email = user.Identity?.Name ?? "";
        displayName = email.Split('@')[0];
        initials = displayName.Length >= 2
            ? displayName[..2].ToUpper()
            : displayName.ToUpper();
    }

    private void GoToMatieres() => Navigation.NavigateTo("/matieres");
    private void GoToEleves() => Navigation.NavigateTo("/eleves");
    private void GoToNotes() => Navigation.NavigateTo("/notes");
    private void GoToRegister() => Navigation.NavigateTo("/register");
    private void GoToMesNotes() => Navigation.NavigateTo("/mes-notes");
}
