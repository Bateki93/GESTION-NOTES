@page "/notes"
@using GestionNotes.Blazor.Services
@inject NoteService NoteService
@inject EleveService EleveService
@inject MatiereService MatiereService
@inject NavigationManager Navigation

<PageTitle>Notes - GestionNotes</PageTitle>

<div class="notes-page">
    <div class="page-heading">
        <h1>Notes</h1>
        <button class="btn-add" @onclick="StartCreate">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nouvelle note
        </button>
    </div>

    @if (loading)
    {
        <div class="loading-state">
            <span class="spinner-lg"></span>
            <p>Chargement...</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Élève</th>
                        <th>Matière</th>
                        <th>Note</th>
                        <th>Semestre</th>
                        <th>Année</th>
                        <th class="th-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in notes.Items)
                    {
                        <tr>
                            <td><span class="fw-600">@n.EleveNom @n.ElevePrenom</span></td>
                            <td>@n.MatiereLibelle</td>
                            <td><span class="grade-badge">@n.Valeur / 20</span></td>
                            <td>S@n.Semestre</td>
                            <td>@n.Annee</td>
                            <td class="td-actions">
                                <button class="btn-icon edit" @onclick="() => StartEdit(n)" title="Modifier">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="btn-icon delete" @onclick="() => Delete(n.Id)" title="Supprimer">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (notes.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-row">Aucune note pour le moment</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (showForm)
        {
            <div class="modal-overlay">
                <div class="modal-card">
                    <div class="modal-header">
                        <h2>@(editingId > 0 ? "Modifier la note" : "Nouvelle note")</h2>
                        <button class="btn-close-modal" @onclick="Cancel">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>

                    <div class="modal-body">
                        <div class="field-group">
                            <label class="field-label">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                Élève
                            </label>
                            <div class="matiere-list">
                                @foreach (var e in elevesList)
                                {
                                    <button type="button"
                                            class="matiere-item @(editModel.EleveId == e.UserId ? "selected" : "")"
                                            @onclick="() => editModel.EleveId = e.UserId">
                                        <span class="matiere-name">@e.Nom @e.Prenom</span>
                                        <span class="matiere-code">@e.Matricule</span>
                                    </button>
                                }
                                @if (elevesList.Count == 0)
                                {
                                    <p class="text-muted">Aucun élève disponible</p>
                                }
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
                                Matière
                            </label>
                            <div class="matiere-list">
                                @foreach (var m in matieresList)
                                {
                                    <button type="button"
                                            class="matiere-item @(editModel.MatiereId == m.Id ? "selected" : "")"
                                            @onclick="() => editModel.MatiereId = m.Id">
                                        <span class="matiere-name">@m.Libelle</span>
                                        <span class="matiere-code">@m.Code</span>
                                    </button>
                                }
                                @if (matieresList.Count == 0)
                                {
                                    <p class="text-muted">Aucune matière disponible</p>
                                }
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="field-group">
                                <label class="field-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                    Note (0-20)
                                </label>
                                <input @bind="editModel.Valeur" type="number" step="0.25" min="0" max="20" class="field-input" placeholder="0-20" />
                            </div>

                            <div class="field-group">
                                <label class="field-label">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    Semestre
                                </label>
                                <select @bind="editModel.Semestre" class="field-input">
                                    <option value="1">Semestre 1</option>
                                    <option value="2">Semestre 2</option>
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label class="field-label">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 10h20"/></svg>
                                Année académique
                            </label>
                            <input @bind="editModel.Annee" class="field-input" placeholder="ex: 2025-2026" />
                        </div>

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="error-message">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                @formError
                            </div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn-cancel" @onclick="Cancel">Annuler</button>
                        <button class="btn-save" @onclick="Save" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-sm"></span>
                                <span>Enregistrement...</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                                <span>Enregistrer</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private Models.PagedResult<Models.NoteModel> notes = new();
    private List<Models.EleveModel> elevesList = [];
    private List<Models.MatiereModel> matieresList = [];
    private bool loading = true;
    private bool showForm;
    private bool saving;
    private int editingId;
    private string? formError;
    private Models.NoteModel editModel = new();

    protected override async Task OnInitializedAsync()
    {
        notes = await NoteService.GetAllAsync();
        elevesList = (await EleveService.GetAllAsync(1, 1000)).Items;
        matieresList = await MatiereService.GetAllAsync();
        loading = false;
    }

    private async Task StartCreate()
    {
        editingId = 0;
        formError = null;
        editModel = new() { EleveId = Guid.Empty, Annee = "2025-2026", Semestre = 1 };
        matieresList = await MatiereService.GetAllAsync();
        elevesList = (await EleveService.GetAllAsync(1, 1000)).Items;
        showForm = true;
    }

    private async Task StartEdit(Models.NoteModel n)
    {
        editingId = n.Id;
        formError = null;
        editModel = new()
        {
            EleveId = n.EleveId,
            MatiereId = n.MatiereId,
            Valeur = n.Valeur,
            Semestre = n.Semestre,
            Annee = n.Annee
        };
        matieresList = await MatiereService.GetAllAsync();
        elevesList = (await EleveService.GetAllAsync(1, 1000)).Items;
        showForm = true;
    }

    private async Task Save()
    {
        formError = null;

        if (editModel.EleveId == Guid.Empty)
        {
            formError = "Veuillez sélectionner un élève";
            return;
        }

        if (editModel.MatiereId == 0)
        {
            formError = "Veuillez sélectionner une matière";
            return;
        }

        if (editModel.Valeur < 0 || editModel.Valeur > 20)
        {
            formError = "La note doit être comprise entre 0 et 20";
            return;
        }

        if (string.IsNullOrWhiteSpace(editModel.Annee))
        {
            formError = "Veuillez renseigner l'année académique";
            return;
        }

        saving = true;

        try
        {
            if (editingId > 0)
                await NoteService.UpdateAsync(editingId, editModel);
            else
                await NoteService.CreateAsync(editModel);

            showForm = false;
            notes = await NoteService.GetAllAsync();
        }
        catch (Exception ex)
        {
            formError = $"Erreur : {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete(int id)
    {
        await NoteService.DeleteAsync(id);
        notes = await NoteService.GetAllAsync();
    }

    private void Cancel() => showForm = false;

    private void OnMatiereChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            editModel.MatiereId = id;
    }

    private void OnEleveChange(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            editModel.EleveId = id;
    }
}
