@page "/register"
@using GestionNotes.Blazor.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Inscription - GestionNotes</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <a href="/" class="auth-logo">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
                    <circle cx="12" cy="12" r="2"/><path d="M12 2v2"/><path d="M12 20v2"/>
                </svg>
                GestionNotes
            </a>
            <h1 class="auth-title">Créer un compte</h1>
            <p class="auth-subtitle">Rejoins GestionNotes et suis tes notes facilement</p>
        </div>

        <EditForm Model="@model" OnValidSubmit="@HandleRegister" class="auth-form">
            <div class="form-row">
                <div class="field-group">
                    <label class="field-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Nom
                    </label>
                    <InputText @bind-Value="model.Nom" class="field-input" placeholder="Ton nom" />
                </div>
                <div class="field-group">
                    <label class="field-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Prénom
                    </label>
                    <InputText @bind-Value="model.Prenom" class="field-input" placeholder="Ton prénom" />
                </div>
            </div>

            <div class="field-group">
                <label class="field-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    Email
                </label>
                <InputText @bind-Value="model.Email" type="email" class="field-input" placeholder="exemple@email.com" />
            </div>

            <div class="field-group">
                <label class="field-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    Mot de passe
                </label>
                <InputText @bind-Value="model.Password" type="password" class="field-input" placeholder="Au moins 6 caractères" />
            </div>

            <div class="field-group">
                <label class="field-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    Rôle
                </label>
                <select @bind="model.RoleId" class="field-input">
                    <option value="2">Élève</option>
                    <option value="1">Administrateur</option>
                </select>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="error-message">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    @error
                </div>
            }

            <button type="submit" class="auth-submit" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner"></span>
                    <span>Inscription...</span>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    <span>S'inscrire</span>
                }
            </button>
        </EditForm>

        <div class="auth-footer">
            Déjà un compte ?
            <a href="/login">Se connecter</a>
        </div>
    </div>
</div>

@code {
    private RegisterModel model = new();
    private string? error;
    private bool loading;

    private class RegisterModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Nom { get; set; } = "";
        public string Prenom { get; set; } = "";
        public int RoleId { get; set; } = 2;
    }

    private async Task HandleRegister()
    {
        loading = true;
        error = null;

        var result = await AuthService.RegisterAsync(model.Email, model.Password, model.Nom, model.Prenom, model.RoleId);

        if (result is not null)
            Navigation.NavigateTo("/");
        else
            error = "Erreur lors de l'inscription (email peut-être déjà utilisé)";

        loading = false;
    }
}
